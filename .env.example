NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
DATABASE_URL=
# Different cryptographically random secrets, at least 32 characters each.
JWT_SECRET=
JWT_REFRESH_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
# Private document provider: r2 (existing deployments) or supabase (free hosting).
STORAGE_PROVIDER=r2
# Private R2 bucket for employee documents.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Supabase Free private bucket. Copy its S3 endpoint, region and server-only access keys.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=

APP_TIMEZONE=UTC
# Set a separate random 32-byte hexadecimal key before offering MFA enrollment.
# Preserve this key in recovery; rotating it requires re-enrollment.
MFA_ENCRYPTION_KEY=
# Enable after configuring the key. Privileged users are restricted to enrollment until enrolled.
MFA_ENFORCE_PRIVILEGED=false
# Private-network ClamAV daemon (never expose its unauthenticated port publicly).
# Keep signatures updated; configure StreamMaxLength >= 40M and AlertExceedsMax yes.
CLAMD_HOST=
CLAMD_PORT=3310
# Enable after provisioning; true blocks uploads if no scanner is configured.
FILE_SCAN_REQUIRED=false
# External scheduler POSTs /internal/scheduled-jobs with Authorization: Bearer <secret> every minute.
# Provision the scheduler before selecting external; in_process cannot run while the host sleeps.
SCHEDULER_MODE=in_process
SCHEDULER_SECRET=
# Operational target only; reviewers must verify applicable legal response deadlines.
PRIVACY_RESPONSE_DAYS=30
# Git commit SHA for non-Render deployments. Render supplies RENDER_GIT_COMMIT.
APP_RELEASE=
# Set demo for demonstrations; operational only after confirming sample-data separation.
# Production blocks payment recording and WPS if this is unset.
APP_DATA_MODE=
