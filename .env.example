NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
DATABASE_URL=
# Different cryptographically random secrets, at least 32 characters each.
JWT_SECRET=
JWT_REFRESH_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
# Private document provider: r2 (existing deployments) or supabase (free hosting).
STORAGE_PROVIDER=r2
# Private R2 bucket for employee documents.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Supabase Free private bucket. Copy its S3 endpoint, region and server-only access keys.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=

APP_TIMEZONE=UTC
